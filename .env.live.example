# Cấu hình LLM thật cho example youtube_playlist_wiki (dùng orchestrator-agent).
# Cách dùng:
#   cp .env.live.example .env.live
#   điền giá trị thật, rồi chạy:
#   cargo run --example youtube_playlist_wiki -- "<PLAYLIST_URL>" --limit 3
#
# Biến môi trường cùng tên luôn ưu tiên hơn giá trị trong file.
# Đổi đường dẫn file bằng --env-file <path> hoặc LIVE_ENV_FILE=/path/to/file.

G0_OPENAI_BASE_URL=http://<lan-gateway-host>:<port>/v1
G0_OPENAI_MODEL=gh/gpt-4o-mini
G0_OPENAI_API_KEY=

